{
  "name": "ai-switch",
  "version": "1.0.5",
  "description": "Sync and prepare AI coding tool configurations for quick model switching.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run lint && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node deploy.mjs",
    "release": "node release.mjs",
    "lint": "eslint \"**/*.{ts,tsx}\""
  },
  "keywords": [
    "ai",
    "models",
    "configuration",
    "coding-tools"
  ],
  "author": "lizhifeng",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "eslint": "^9.39.4",
    "typescript-eslint": "^8.58.2",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "@eslint/json": "^0.14.0"
  }
}
